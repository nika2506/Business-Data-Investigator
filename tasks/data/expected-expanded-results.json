          },
          {
            "order_id": "O5",
            "refund_count": 2,
            "total_refund_cents": 2000,
            "order_amount_cents": 4000
          }
        ]
      }
    },
    {
      "case_id": "case_04_cross_month_refunds",
      "question": "Which refunds occurred in a different month from the original order?",
      "input": {
        "all_refunds": true
      },
      "rule_ids": [
        "R1",
        "R2",
        "R4"
      ],
      "expected": {
        "refunds": [
          {
            "refund_id": "RF4",
